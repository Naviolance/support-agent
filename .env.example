# ---- Agent database (this project's own data: conversations, messages, tool calls) ----
# Started by docker-compose.yml in this repo, on port 5434.
AGENT_DB_USER=support_agent
AGENT_DB_PASSWORD=support_agent_local_password
AGENT_DB_NAME=support_agent
AGENT_DB_PORT=5434
AGENT_DATABASE_URL="postgresql://support_agent:support_agent_local_password@localhost:5434/support_agent"

# ---- Store database (read-only, owned by the truck parts store) ----
# The agent_readonly user created by db/store-readonly-user.sql.
STORE_READONLY_URL="postgresql://agent_readonly:change_me@localhost:5433/truckparts"

# ---- Server ----
PORT=3000
